{
  "swagger": "2.0",
  "info": {
    "version": "v1.1.0",
    "title": "Salon Colaborativo API",
    "description": "SalonColaborativo es una plataforma que permite la interacción sincronica entre usuarios por medio de chats, videollamadas, compartir pantalla y otras herramientas basicas de apoyo al estudio.\n\nAutenticación: inicia sesión en el frontend con Firebase (correo o Google) y envía el ID token en `Authorization: Bearer <token>`. En Swagger usa el botón **Authorize**."
  },
  "host": "localhost:3000",
  "basePath": "/api/v1",
  "tags": [
    {
      "name": "Sistema",
      "description": "Estado del servicio"
    },
    {
      "name": "Usuarios",
      "description": "Perfiles de usuario (requieren sesión)"
    },
    {
      "name": "Salas",
      "description": "Gestión de salas propias (requiere sesión)"
    },
    {
      "name": "Mensajes",
      "description": "Consulta de mensajes (requieren sesión)"
    }
  ],
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Escribe: Bearer <ID token de Firebase>"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Estado del servicio (pública)",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/diagnostico": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Prueba de extremo a extremo: lee diagnostico/sistema en Firestore (pública)",
        "description": "",
        "responses": {
          "200": {
            "description": "Firestore respondió",
            "schema": {
              "$ref": "#/definitions/Diagnostico"
            }
          },
          "404": {
            "description": "El documento de diagnóstico no existe",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "503": {
            "description": "Firestore no disponible",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/users/me": {
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Crea el perfil del usuario autenticado (primer inicio de sesión)",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CrearPerfil"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Perfil creado",
            "schema": {
              "$ref": "#/definitions/Perfil"
            }
          },
          "400": {
            "description": "Datos inválidos",
            "schema": {
              "$ref": "#/definitions/ErrorValidacion"
            }
          },
          "401": {
            "description": "Sin sesión válida (no autorizado)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Perfil existente o nombre de usuario en uso",
            "schema": {
              "$ref": "#/definitions/ErrorValidacion"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Devuelve el perfil del usuario autenticado",
        "description": "",
        "responses": {
          "200": {
            "description": "Perfil del usuario",
            "schema": {
              "$ref": "#/definitions/Perfil"
            }
          },
          "401": {
            "description": "Sin sesión válida (no autorizado)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "El usuario aún no tiene perfil",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Actualiza el perfil del usuario autenticado",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ActualizarPerfil"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil actualizado",
            "schema": {
              "$ref": "#/definitions/Perfil"
            }
          },
          "400": {
            "description": "Datos inválidos",
            "schema": {
              "$ref": "#/definitions/ErrorValidacion"
            }
          },
          "401": {
            "description": "Sin sesión válida (no autorizado)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "El usuario aún no tiene perfil",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Nombre de usuario en uso",
            "schema": {
              "$ref": "#/definitions/ErrorValidacion"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Elimina el perfil, las salas propias y la cuenta de Firebase. Libera el usuario.",
        "description": "",
        "responses": {
          "204": {
            "description": "Cuenta eliminada"
          },
          "401": {
            "description": "Sin sesión válida"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/me/email": {
      "patch": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Cambia el correo en Firebase Authentication",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ActualizarCorreo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Correo actualizado",
            "schema": {
              "$ref": "#/definitions/Perfil"
            }
          },
          "400": {
            "description": "Correo inválido"
          },
          "401": {
            "description": "Sin sesión válida"
          },
          "403": {
            "description": "Se requiere iniciar sesión de nuevo"
          },
          "404": {
            "description": "Perfil no encontrado"
          },
          "409": {
            "description": "Correo en uso",
            "schema": {
              "$ref": "#/definitions/ErrorValidacion"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rooms/": {
      "get": {
        "tags": [
          "Salas"
        ],
        "summary": "Lista únicamente las salas propias",
        "description": "",
        "responses": {
          "200": {
            "description": "Salas propias",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Sala"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Sin sesión válida"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Salas"
        ],
        "summary": "Crea una sala propia con ID único",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CrearSala"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Sala creada",
            "schema": {
              "$ref": "#/definitions/Sala"
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Sin sesión válida"
          },
          "404": {
            "description": "Perfil no encontrado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rooms/{id}": {
      "patch": {
        "tags": [
          "Salas"
        ],
        "summary": "Renombra una sala propia",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RenombrarSala"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sala renombrada"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Sin sesión válida"
          },
          "404": {
            "description": "La sala no existe o pertenece a otro usuario"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Salas"
        ],
        "summary": "Elimina una sala propia",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Sala eliminada"
          },
          "401": {
            "description": "Sin sesión válida"
          },
          "404": {
            "description": "La sala no existe o pertenece a otro usuario"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/1/{id}": {
      "get": {
        "tags": [
          "Mensajes"
        ],
        "summary": "Consulta un documento de Firestore (ruta de prueba, privada)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sin sesión válida (no autorizado)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "ActualizarCorreo": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "nuevo@correo.com"
        }
      },
      "required": [
        "email"
      ]
    },
    "CrearSala": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "string",
          "example": "Grupo de cálculo"
        },
        "materia": {
          "type": "string",
          "example": "Matemáticas"
        },
        "descripcion": {
          "type": "string",
          "example": "Preparación del parcial"
        },
        "publica": {
          "type": "boolean",
          "example": false
        }
      },
      "required": [
        "nombre",
        "materia",
        "publica"
      ]
    },
    "RenombrarSala": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "string",
          "example": "Grupo de cálculo II"
        }
      },
      "required": [
        "nombre"
      ]
    },
    "Sala": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "9u0XbRiQ30FP63sfwP4z"
        },
        "ownerUid": {
          "type": "string",
          "example": "firebase-uid"
        },
        "nombre": {
          "type": "string",
          "example": "Grupo de cálculo"
        },
        "materia": {
          "type": "string",
          "example": "Matemáticas"
        },
        "descripcion": {
          "type": "string",
          "example": "Preparación del parcial"
        },
        "publica": {
          "type": "boolean",
          "example": false
        },
        "createdAt": {
          "type": "string",
          "example": "2026-11-17T15:00:00.000Z"
        }
      }
    },
    "Diagnostico": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Conexión con Firestore funcionando"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "no autorizado"
        }
      }
    },
    "ErrorValidacion": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "Datos inválidos"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "example": "username"
              },
              "message": {
                "type": "string",
                "example": "El nombre de usuario ya está en uso"
              }
            }
          }
        }
      }
    },
    "CrearPerfil": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "example": "nico_dev"
        },
        "displayName": {
          "type": "string",
          "example": "Nicolás Mosorongo"
        },
        "photoURL": {
          "type": "string",
          "example": "https://example.com/foto.png"
        },
        "bio": {
          "type": "string",
          "example": "Estudiante de Univalle"
        }
      },
      "required": [
        "username",
        "displayName"
      ]
    },
    "ActualizarPerfil": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "example": "nico_dev"
        },
        "displayName": {
          "type": "string",
          "example": "Nicolás Mosorongo"
        },
        "photoURL": {
          "type": "string",
          "example": "https://example.com/foto.png"
        },
        "bio": {
          "type": "string",
          "example": "Estudiante de Univalle"
        }
      }
    },
    "Perfil": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "example": "k3J9...firebase-uid"
        },
        "email": {
          "type": "string",
          "example": "nico@correo.com"
        },
        "username": {
          "type": "string",
          "example": "nico_dev"
        },
        "displayName": {
          "type": "string",
          "example": "Nicolás Mosorongo"
        },
        "photoURL": {
          "type": "string",
          "example": "https://example.com/foto.png"
        },
        "bio": {
          "type": "string",
          "example": "Estudiante de Univalle"
        },
        "provider": {
          "type": "string",
          "example": "password"
        },
        "createdAt": {
          "type": "string",
          "example": "2026-11-12T15:00:00.000Z"
        },
        "updatedAt": {
          "type": "string",
          "example": "2026-11-12T15:00:00.000Z"
        }
      }
    }
  }
}