# Puerto del servidor (Render lo define solo; en local usa 3000)
PORT=3000

# Orígenes permitidos por CORS, separados por coma, sin "/" final.
# Local + frontend desplegado en Vercel:
CORS_ORIGIN=http://localhost:5173,https://tu-frontend.vercel.app

# Credenciales del Admin SDK de Firebase (Configuración del proyecto > Cuentas de servicio)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-firebase-private-key\n-----END PRIVATE KEY-----\n"